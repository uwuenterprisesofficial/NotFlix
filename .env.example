# Copy to .env. Create a MyAnimeList API client at https://myanimelist.net/apiconfig
# (App Type: "web", App Redirect URL: http://localhost:3000/api/auth/callback).
# AniList (optional, instead of or next to MAL): https://anilist.co/settings/developer with the
# redirect URL http://localhost:3000/api/auth/anilist/callback.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/api/auth/anilist/callback

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Signs the session cookie. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Every request to the API needs this key (header X-API-Key); the API doesn't start without one
# (at least 16 characters). Generate it like SECRET_KEY. The desktop app asks for it.
API_KEY=
# The web app on :3000 adds this key to its requests. Leave it empty and the web app only passes
# on requests that bring the key themselves (the desktop app); set it to API_KEY to use NotFlix
# in a browser too (then anyone who can open the web app uses the API through it).
WEB_API_KEY=
FRONTEND_URL=http://localhost:3000

# Stream providers. An empty URL disables that provider.
# English sources from APIs you run yourself (disabled by default). With docker compose, a
# service on your machine is http://host.docker.internal:<port>, not localhost.
ANIVEXA_URL=
REANIME_URL=
# German sources come from the bundled AniScraper service (aniworld.to + animetoast.cc; docker
# compose starts it and uses http://aniscraper:8000). Uncomment to switch it off and use one of
# the AniWorld options below instead.
# ANISCRAPER_URL=
# With your own AniWorld API (GET /api/series/{title}/episodes/{season}[/{episode}])
# set ANIWORLD_API_URL; it replaces scraping ANIWORLD_URL.
ANIWORLD_API_URL=
# With several of these set, the first one (AniScraper, the API, scraping) gives AniWorld; or name
# one: ANIWORLD_VIA=aniscraper, api or site. (AniScraper keeps serving AnimeToast.)
ANIWORLD_VIA=
# Hybrid mode (set by the desktop app for its built-in server, not needed elsewhere): the online
# NotFlix server whose catalogue and shared stream library this server uses, and its API key.
UPSTREAM_URL=
UPSTREAM_API_KEY=
# Without it AniWorld is scraped directly. Switch to a mirror if the domain changes; if AniWorld
# answers with 404s, try ANIWORLD_SERIES_PATH=anime/stream/{slug}.
ANIWORLD_URL=https://aniworld.to
ANIWORLD_SERIES_PATH=anime/{slug}

# An intro/outro analysis running longer than this (minutes) is stopped and marked failed.
ANALYSIS_TIMEOUT_MINUTES=10

# The catalogue (database) answers first; MAL data older than this many days is refreshed in
# the background (airing shows: after a day; 0 never). Synopsis languages looked up for every
# show added to the catalogue (German comes from AniWorld/AnimeToast).
CATALOG_REFRESH_DAYS=30
CATALOG_SYNOPSIS_LANGUAGES=de

# Jikan (unofficial MyAnimeList API) for the genre search; MAL's own API can't list shows by
# genre. Empty: the genre search only finds shows NotFlix already knows.
JIKAN_URL=https://api.jikan.moe/v4

# AniSkip's crowd-sourced opening/ending times, used until an episode's own are detected.
# Empty: off.
ANISKIP_URL=https://api.aniskip.com

# Only used when running the backend outside docker compose (paths relative to backend/).
DATABASE_URL=postgresql+psycopg://notflix:notflix@localhost:5432/notflix
REDIS_URL=redis://localhost:6379/0
MEDIA_DIR=../media

# Who may open the admin page (Settings -> Admin): MAL/AniList names or NotFlix user ids,
# comma-separated. Empty: everyone signed in with a list (not Watch Together guests).
ADMINS=
