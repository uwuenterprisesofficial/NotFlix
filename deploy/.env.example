# NotFlix on a server: copy to .env next to docker-compose.yml and fill in (or enter the same as
# your deploy tool's environment variables).
# Generate secrets with: openssl rand -hex 32   (letters and digits only: no $, @, % or quotes,
# which .env or the database address would read differently)

# --- Images (pushed by scripts/publish.sh) ---
REGISTRY=registry.uwuenterprises.de
TAG=latest

# --- Required ---
# Every request to the API needs it (the desktop app asks for it next to the server's address).
API_KEY=
# Signs the session cookies.
SECRET_KEY=
# The database's password (only used inside the Docker network). PostgreSQL takes it only when
# it creates its data: changing it later needs ALTER USER (see the README).
POSTGRES_PASSWORD=
# The server's public address (the backend, port 6500 or your HTTPS proxy in front of it),
# without a trailing slash. Sign-ins come back here and go on to the desktop app.
FRONTEND_URL=https://notflix.example.com

# --- Signing in (at least one) ---
# https://myanimelist.net/apiconfig, redirect URL: <FRONTEND_URL>/auth/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# https://anilist.co/settings/developer, redirect URL: <FRONTEND_URL>/auth/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Only if the redirect URLs differ from the ones above:
# MAL_REDIRECT_URI=
# ANILIST_REDIRECT_URI=

# Who may open the admin page (MAL/AniList names or user ids, comma-separated). Empty: anyone with a list.
ADMINS=

# --- Optional (see the repository's .env.example for all settings) ---
# Stream sources (ANISCRAPER_URL, ANIWORLD_URL, ANIVEXA_URL, ...) are always off on the server:
# the desktop apps find streams (hybrid mode) and share them with this server's library.
