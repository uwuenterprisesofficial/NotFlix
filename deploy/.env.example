# NotFlix on a server: copy to .env next to docker-compose.yml and fill in.
# Generate secrets with: openssl rand -base64 32   (or: python3 -c "import secrets; print(secrets.token_urlsafe(32))")

# --- Images (pushed by scripts/publish.sh) ---
REGISTRY=registry.mfhost.de
TAG=publish

# --- Required ---
# Every request to the API needs it (the desktop app asks for it next to the server's address).
API_KEY=
# Signs the session cookies.
SECRET_KEY=
# The database's password (only used inside the Docker network).
POSTGRES_PASSWORD=
# Where the web app is reached from outside, without a trailing slash. Sign-ins come back here.
FRONTEND_URL=https://notflix.example.com

# --- Web app ---
# The port the web app listens on (put your HTTPS reverse proxy in front of it).
WEB_PORT=3000
# Set to API_KEY to use NotFlix in a browser. Empty: only the desktop app gets through (it
# brings the key itself), browsers get nothing.
WEB_API_KEY=

# --- Signing in (at least one) ---
# https://myanimelist.net/apiconfig, redirect URL: <FRONTEND_URL>/api/auth/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=https://notflix.example.com/api/auth/callback
# https://anilist.co/settings/developer, redirect URL: <FRONTEND_URL>/api/auth/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=https://notflix.example.com/api/auth/anilist/callback

# Who may open the admin page (MAL/AniList names or user ids, comma-separated). Empty: anyone with a list.
ADMINS=

# --- Optional (see the repository's .env.example for all settings) ---
# ANIVEXA_URL=http://host.docker.internal:3001
# ANIWORLD_VIA=
# CATALOG_SYNOPSIS_LANGUAGES=de
