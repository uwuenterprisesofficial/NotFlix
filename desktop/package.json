{
  "name": "notflix-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "NotFlix as a desktop app: with its own built-in server, or connected to a NotFlix server",
  "main": "main.js",
  "scripts": {
    "server": "node scripts/prepare-server.mjs",
    "stack": "node scripts/prepare-stack.mjs",
    "start": "electron .",
    "dist": "npm run server && npm run stack && electron-builder",
    "dist:win": "npm run server && npm run stack && electron-builder --win",
    "dist:mac": "npm run server && npm run stack && electron-builder --mac",
    "dist:linux": "npm run server && npm run stack && electron-builder --linux",
    "dist:client": "npm run server && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.notflix.desktop",
    "productName": "NotFlix",
    "files": [
      "main.js",
      "builtin-server.js",
      "preload.js",
      "updater.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NotFlix-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    },
    "afterPack": "scripts/after-pack.cjs",
    "portable": {
      "artifactName": "NotFlix-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1/updates"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
