<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- AniWorld through SerienStreamAPI as a small web service for NotFlix (ANIWORLD_API_URL).
       Published by desktop/scripts/prepare-stack.mjs as one self-contained executable. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aniworld-api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SerienStreamAPI" Version="1.1.2" />
  </ItemGroup>

</Project>
